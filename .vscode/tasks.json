{
    // Tasks used by launch.json: serve the site on http://localhost:8743 while debugging.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serve portfolio",
            "type": "shell",
            // -u prints the "Serving HTTP" line immediately, which tells VS Code the server is ready
            "command": "python3 -u -m http.server 8743 --bind 127.0.0.1",
            "isBackground": true,
            "problemMatcher": {
                "owner": "portfolio-server",
                "pattern": { "regexp": "a^" },
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "^Serving HTTP",
                    "endsPattern": "^Serving HTTP"
                }
            },
            "presentation": { "reveal": "silent", "panel": "dedicated" }
        },
        {
            "label": "Stop portfolio server",
            "type": "shell",
            "command": "echo ${input:terminateServer}",
            "presentation": { "reveal": "never" }
        }
    ],
    "inputs": [
        {
            "id": "terminateServer",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "Serve portfolio"
        }
    ]
}
